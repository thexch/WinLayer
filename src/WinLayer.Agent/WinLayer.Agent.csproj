<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>WinLayer</AssemblyName>
    <RootNamespace>WinLayer.Agent</RootNamespace>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.22000.0</SupportedOSPlatformVersion>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>WinLayer.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <!-- Both package entry points share the full Windows Desktop runtime. -->
    <FrameworkReference Include="Microsoft.WindowsDesktop.App" />
    <ProjectReference Include="../WinLayer.Modules/WinLayer.Modules.csproj" />
    <PackageReference Include="Velopack" Version="1.2.161" />
    <EmbeddedResource Include="WinLayer.ico" LogicalName="WinLayer.ico" />
  </ItemGroup>
</Project>
